NODE_ENV=production
HOST=127.0.0.1
PORT=3000
SITE_URL=https://darkguyaiman.com
CACHE_REVALIDATE_MS=15000
CACHE_MAX_STALE_MS=300000
CACHE_MAX_ENTRIES=50
CACHE_HTML_S_MAXAGE=3600
CACHE_HTML_STALE_SECONDS=86400
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=darkguyaiman-com
CMS_PASSWORD=change-this-password
CMS_USERNAME=set-your-username
GROQ_API_KEY=your-groq-api-key
# Add as many numbered fallback keys as needed (gaps in numbering are fine).
# GROQ_API_KEY_2=your-second-groq-api-key
# GROQ_API_KEY_3=your-third-groq-api-key
# Alternatively, use a comma-separated list:
# GROQ_API_KEYS=your-first-groq-api-key,your-second-groq-api-key
