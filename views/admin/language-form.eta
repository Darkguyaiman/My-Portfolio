<%~ include('partials/header', { title, active }) %>
<section class="cms-page-heading">
    <div>
        <p class="cms-kicker">Languages</p>
        <h1><%= title %></h1>
        <p>Use clear levels like Advanced, Intermediate, Native, or Beginner.</p>
    </div>
    <a href="/admin/languages" class="cms-button secondary"><i class="fas fa-chevron-left"></i><span>Back</span></a>
</section>

<form method="post" action="<%= action %>" class="cms-panel cms-form">
    <div class="cms-form-grid two">
        <label><span>Language name</span><input name="name" value="<%= language.name %>" required></label>
        <%~ include('partials/dropdown', {
            name: 'level',
            label: 'Level',
            value: language.level,
            options: ['Native', 'Advanced', 'Intermediate', 'Beginner'],
            placeholder: 'Select level',
            required: true,
            ariaLabel: 'Language level'
        }) %>
    </div>
    <div class="cms-form-actions">
        <button type="submit" class="cms-button primary"><i class="fas fa-floppy-disk"></i><span>Save Language</span></button>
    </div>
</form>
<%~ include('partials/footer') %>
