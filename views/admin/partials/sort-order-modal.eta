<div class="cms-modal" id="cmsSortModal" hidden aria-hidden="true">
    <div class="cms-modal-backdrop" data-close-sort-modal></div>
    <div class="cms-modal-panel" role="dialog" aria-modal="true" aria-labelledby="cmsSortModalTitle">
        <header class="cms-modal-header">
            <div>
                <p class="cms-kicker">Display order</p>
                <h2 id="cmsSortModalTitle">Sort items</h2>
            </div>
            <button type="button" class="cms-icon-button" data-close-sort-modal aria-label="Close sort dialog">
                <i class="fas fa-xmark" aria-hidden="true"></i>
            </button>
        </header>
        <p class="cms-modal-copy">Drag items to set the order shown on your site. This does not affect table search or sorting.</p>
        <ul class="cms-sort-list" id="cmsSortList"></ul>
        <footer class="cms-modal-actions">
            <button type="button" class="cms-button secondary" data-close-sort-modal>Cancel</button>
            <button type="button" class="cms-button primary" id="cmsSortSave">
                <i class="fas fa-floppy-disk" aria-hidden="true"></i>
                <span>Save order</span>
            </button>
        </footer>
    </div>
</div>
