<%~ include('partials/header', { title: 'Languages', active }) %>
<section class="cms-page-heading">
    <div>
        <p class="cms-kicker">Languages</p>
        <h1>Manage languages</h1>
        <p>Edit the human languages section shown near the bottom of the homepage.</p>
    </div>
    <div class="cms-page-heading-actions">
        <% if (rows.length) { %>
            <script type="application/json" class="cms-sort-modal-data"><%~ JSON.stringify(rows.map((row) => ({ id: row.id, label: row.name, meta: row.level }))) %></script>
            <button type="button" class="cms-button secondary cms-sort-modal-trigger" data-reorder-url="/admin/languages/reorder" data-modal-title="Sort languages">
                <i class="fas fa-arrow-down-wide-short" aria-hidden="true"></i><span>Sort order</span>
            </button>
        <% } %>
        <a href="/admin/languages/new" class="cms-button primary"><i class="fas fa-plus"></i><span>New Language</span></a>
    </div>
</section>

<section class="cms-panel">
    <div class="cms-table-wrap" data-selectable="false">
        <table class="cms-table">
            <thead><tr><th>Order</th><th>Name</th><th>Level</th><th></th></tr></thead>
            <tbody>
                <% rows.forEach((row) => { %>
                    <tr>
                        <td><%= row.display_order %></td>
                        <td><strong><%= row.name %></strong></td>
                        <td><%= row.level %></td>
                        <td class="cms-table-actions">
                            <a href="/admin/languages/<%= row.id %>/edit" class="cms-icon-button" aria-label="Edit <%= row.name %>"><i class="fas fa-pen"></i></a>
                            <form method="post" action="/admin/languages/<%= row.id %>/delete" onsubmit="return confirm('Delete this language?')">
                                <button class="cms-icon-button danger" type="submit" aria-label="Delete <%= row.name %>"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</section>
<%~ include('partials/footer') %>
