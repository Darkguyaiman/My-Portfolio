<%~ include('partials/header', { title: 'Work', active }) %>
<section class="cms-page-heading">
    <div>
        <p class="cms-kicker">Work</p>
        <h1>Manage work history</h1>
        <p>Edit company roles, dates, logos, and timeline bullet points.</p>
    </div>
    <div class="cms-page-heading-actions">
        <% if (rows.length) { %>
            <script type="application/json" class="cms-sort-modal-data"><%~ JSON.stringify(rows.map((row) => ({ id: row.id, label: row.company, meta: row.role }))) %></script>
            <button type="button" class="cms-button secondary cms-sort-modal-trigger" data-reorder-url="/admin/work/reorder" data-modal-title="Sort work history">
                <i class="fas fa-arrow-down-wide-short" aria-hidden="true"></i><span>Sort order</span>
            </button>
        <% } %>
        <a href="/admin/work/new" class="cms-button primary"><i class="fas fa-plus"></i><span>New Work Item</span></a>
    </div>
</section>

<section class="cms-panel">
    <div class="cms-table-wrap">
        <table class="cms-table">
            <thead><tr><th>Order</th><th>Company</th><th>Role</th><th>Dates</th><th></th></tr></thead>
            <tbody>
                <% rows.forEach((row) => { %>
                    <tr>
                        <td><%= row.display_order %></td>
                        <td><strong><%= row.company %></strong><span><%= row.logo || 'No logo' %></span></td>
                        <td><%= row.role %></td>
                        <td><%= row.start_date %> - <%= row.end_date %></td>
                        <td class="cms-table-actions">
                            <a href="/admin/work/<%= row.id %>/edit" class="cms-icon-button" aria-label="Edit <%= row.company %>"><i class="fas fa-pen"></i></a>
                            <form method="post" action="/admin/work/<%= row.id %>/delete" onsubmit="return confirm('Delete this work item?')">
                                <button class="cms-icon-button danger" type="submit" aria-label="Delete <%= row.company %>"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</section>
<%~ include('partials/footer') %>
