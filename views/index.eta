<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mohamed Aiman - Web Developer Portfolio</title>
    <meta name="description" content="Mohamed Aiman is a 17-year-old web developer from Malaysia, specializing in server-side development. Explore my projects, work experience, and skills in Node.js, Express, MySQL, and more.">
    <meta name="keywords" content="Mohamed Aiman, web developer, backend developer, Node.js, Express.js, MySQL, portfolio, Malaysia, Myanmar, Sudan">
    <meta name="author" content="Mohamed Aiman">
    <meta name="robots" content="index, follow">
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://darkguyaiman.github.io/">
    <meta property="og:title" content="Mohamed Aiman - Web Developer Portfolio">
    <meta property="og:description" content="Mohamed Aiman is a 17-year-old web developer from Malaysia, specializing in server-side development. Explore my projects, work experience, and skills.">
    <meta property="og:image" content="https://darkguyaiman.github.io/assets/Mohamed Aiman.webp">
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" content="https://darkguyaiman.github.io/">
    <meta name="twitter:title" content="Mohamed Aiman - Web Developer Portfolio">
    <meta name="twitter:description" content="Mohamed Aiman is a 17-year-old web developer from Malaysia, specializing in server-side development. Explore my projects, work experience, and skills.">
    <meta name="twitter:image" content="https://darkguyaiman.github.io/assets/Mohamed Aiman.webp">
    
    <!-- Canonical URL -->
    <link rel="canonical" href="https://darkguyaiman.github.io/">
    
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <script>
        (function() {
            const savedTheme = localStorage.getItem('theme') || 'dark';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
    <style>html{background:#fdfbf7}html[data-theme="dark"]{background:#1a1a1c}</style>
    <link rel="preload" href="/vendor/fonts/inter/inter-latin-400-normal.woff2?v=<%= assetVersion %>" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/css/app.min.css?v=<%= assetVersion %>">
    <link rel="stylesheet" href="/css/home.min.css?v=<%= assetVersion %>">
    <link rel="stylesheet" href="/css/projects.min.css?v=<%= assetVersion %>">
    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= assetVersion %>">
    <link rel="stylesheet" href="/vendor/devicon/devicon.min.css?v=<%= assetVersion %>">
    <link rel="stylesheet" href="/vendor/lenis/lenis.css?v=<%= assetVersion %>">
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="nav-container">
            <div class="logo">
                <a href="#home" class="logo-link">Darkguyaiman</a>
                <!-- Easter Egg Modal -->
                <div class="easter-egg" id="easterEgg">
                    <div class="easter-egg-content">
                        <div class="easter-egg-image-container">
                            <img src="/assets/2D Mohamed.webp" alt="2D Mohamed" class="easter-egg-image">
                        </div>
                        <div class="easter-egg-name">darkguyaiman</div>
                        <div class="easter-egg-message" id="easterEggMessage"></div>
                    </div>
                </div>
            </div>
            <ul class="nav-menu" id="navMenu">
                <li class="nav-close-container">
                    <button class="nav-close-btn" id="navCloseBtn" aria-label="Close menu">
                        <i class="fas fa-times"></i>
                    </button>
                </li>
                <li><a href="#home" class="nav-link">home</a></li>
                <li><a href="#projects" class="nav-link">projects</a></li>
                <li><a href="#work" class="nav-link">work</a></li>
                <li><a href="#education" class="nav-link">education</a></li>
                <li><a href="#languages" class="nav-link">languages</a></li>
                <li><a href="#contact" class="nav-link">contact</a></li>
                <li class="nav-image-container">
                    <div class="nav-image-wrapper">
                        <div class="nav-greeting-wrapper">
                            <span class="nav-greeting" id="navGreeting"></span>
                        </div>
                        <div class="nav-image-content">
                            <div class="nav-image-glow"></div>
                            <img src="/assets/2D Mohamed Leaning.webp" alt="2D Mohamed Leaning" class="nav-leaning-image">
                            <div class="nav-name">darkguyaiman</div>
                        </div>
                    </div>
                </li>
            </ul>
            <div class="nav-controls">
                <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme">
                    <i class="fas fa-sun" id="themeIcon"></i>
                </button>
                <div class="hamburger" id="hamburger">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
        </div>
    </nav>

    <main>
    <!-- Hero Section -->
    <section id="home" class="hero">
        <div class="container">
            <div class="hero-content">
                <div class="hero-text">
                    <h1 class="hero-title"><%= content.heroTitlePrefix %> <span class="name-highlight"><%= content.heroName %></span>.</h1>
                    <p class="hero-subtitle"><%~ content.heroSubtitle %></p>
                    <p class="hero-description">
                        <%= content.heroDescription %>
                    </p>
                    <div class="hero-links">
                        <a href="<%= content.resumePath %>" target="_blank" class="resume-link" id="resumeLink">
                            <i class="fas fa-file-pdf"></i>
                            Resume
                        </a>
                        <div class="social-links">
                            <a href="<%= content.linkedinUrl %>" target="_blank" class="social-link" aria-label="LinkedIn"><i class="fab fa-linkedin"></i></a>
                            <a href="<%= content.githubUrl %>" target="_blank" class="social-link" aria-label="GitHub"><i class="fab fa-github"></i></a>
                            <a href="<%= content.xUrl %>" target="_blank" class="social-link" aria-label="X (Twitter)"><i class="fab fa-x-twitter"></i></a>
                            <a href="<%= content.instagramUrl %>" target="_blank" class="social-link" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                            <a href="<%= content.facebookUrl %>" target="_blank" class="social-link" aria-label="Facebook"><i class="fab fa-facebook"></i></a>
                            <a href="mailto:<%= content.email %>" class="social-link" aria-label="Email"><i class="fas fa-envelope"></i></a>
                        </div>
                    </div>
                </div>
                <div class="hero-image-container">
                    <div class="image-wrapper">
                        <img src="/assets/Mohamed Aiman.webp" alt="Mohamed Aiman" class="profile-image" id="profileImage">
                        <img src="/assets/Mohamed Aiman Alter Ego.webp" alt="Mohamed Aiman Alter Ego" class="profile-image alter-ego" id="alterEgoImage">
                        <div class="image-glow"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Skills Section -->
    <section class="skills">
        <div class="container">
            <div class="skills-grid">
                <div class="skill-item" data-skill="nextjs">
                    <i class="devicon-nextjs-original colored"></i>
                    <span class="skill-name">Next.js</span>
                    <span class="skill-number"></span>
                </div>
                <div class="skill-item" data-skill="react">
                    <i class="devicon-react-original colored"></i>
                    <span class="skill-name">React</span>
                    <span class="skill-number"></span>
                </div>
                <div class="skill-item" data-skill="nginx">
                    <i class="devicon-nginx-original colored"></i>
                    <span class="skill-name">Nginx</span>
                    <span class="skill-number"></span>
                </div>
                <div class="skill-item" data-skill="ubuntu">
                    <i class="devicon-ubuntu-plain colored"></i>
                    <span class="skill-name">Ubuntu</span>
                    <span class="skill-number"></span>
                </div>
                <div class="skill-item" data-skill="typescript">
                    <i class="devicon-typescript-plain colored"></i>
                    <span class="skill-name">TypeScript</span>
                    <span class="skill-number"></span>
                </div>
                <div class="skill-item" data-skill="googlecloud">
                    <i class="devicon-googlecloud-plain colored"></i>
                    <span class="skill-name">Google Cloud</span>
                    <span class="skill-number"></span>
                </div>
                <div class="skill-item" data-skill="html">
                    <i class="devicon-html5-plain colored"></i>
                    <span class="skill-name">HTML</span>
                    <span class="skill-number"></span>
                </div>
                <div class="skill-item" data-skill="css">
                    <i class="devicon-css3-plain colored"></i>
                    <span class="skill-name">CSS</span>
                    <span class="skill-number"></span>
                </div>
                <div class="skill-item" data-skill="javascript">
                    <i class="devicon-javascript-plain colored"></i>
                    <span class="skill-name">JavaScript</span>
                    <span class="skill-number"></span>
                </div>
                <div class="skill-item" data-skill="node">
                    <i class="devicon-nodejs-plain colored"></i>
                    <span class="skill-name">Node</span>
                    <span class="skill-number"></span>
                </div>
                <div class="skill-item" data-skill="express">
                    <i class="devicon-express-original colored"></i>
                    <span class="skill-name">Express</span>
                    <span class="skill-number"></span>
                </div>
                <div class="skill-item" data-skill="mysql">
                    <i class="devicon-mysql-plain colored"></i>
                    <span class="skill-name">MySQL</span>
                    <span class="skill-number"></span>
                </div>
                <div class="skill-item" data-skill="jquery">
                    <i class="devicon-jquery-plain colored"></i>
                    <span class="skill-name">jQuery</span>
                    <span class="skill-number"></span>
                </div>
                <div class="skill-item" data-skill="ejs">
                    <span class="ejs-icon">EJS</span>
                    <span class="skill-name">EJS</span>
                    <span class="skill-number"></span>
                </div>
                <div class="skill-item" data-skill="tailwind">
                    <i class="devicon-tailwindcss-plain colored"></i>
                    <span class="skill-name">Tailwind</span>
                    <span class="skill-number"></span>
                </div>
            </div>
        </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="projects">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">featured projects</h2>
                <a href="/projects" class="view-more">view more <i class="fas fa-chevron-right"></i></a>
            </div>
            <div class="projects-grid" id="projectsGrid">
                <!-- Projects will be dynamically loaded from the API -->
            </div>
        </div>
    </section>

    <!-- Work Section -->
    <section id="work" class="work">
        <div class="container">
            <h2 class="section-title">Work</h2>
            <div class="timeline" id="workTimeline">
                <!-- Work items will be dynamically loaded from the API -->
            </div>
        </div>
    </section>

    <!-- Education Section -->
    <section id="education" class="education">
        <div class="container">
            <h2 class="section-title">Education</h2>
            <div class="timeline" id="educationTimeline">
                <!-- Education items will be dynamically loaded from the API -->
            </div>
        </div>
    </section>

    <!-- Languages Section -->
    <section id="languages" class="languages">
        <div class="container">
            <h2 class="section-title">I speak these human languages</h2>
            <div class="languages-grid" id="languagesGrid">
                <!-- Languages will be dynamically loaded from the API -->
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="contact">
        <div class="container">
            <div class="contact-content">
                <h2 class="section-title contact-title">contact</h2>
                <div class="contact-wrapper">
                    <p class="contact-text">
                        <%= content.contactText %>
                    </p>
                    <div class="contact-links">
                        <a href="<%= content.linkedinUrl %>" target="_blank" class="contact-link" aria-label="LinkedIn"><i class="fab fa-linkedin"></i></a>
                        <a href="<%= content.githubUrl %>" target="_blank" class="contact-link" aria-label="GitHub"><i class="fab fa-github"></i></a>
                        <a href="<%= content.xUrl %>" target="_blank" class="contact-link" aria-label="X (Twitter)"><i class="fab fa-x-twitter"></i></a>
                        <a href="<%= content.instagramUrl %>" target="_blank" class="contact-link" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                        <a href="<%= content.facebookUrl %>" target="_blank" class="contact-link" aria-label="Facebook"><i class="fab fa-facebook"></i></a>
                        <a href="mailto:<%= content.email %>" class="contact-link" aria-label="Email"><i class="fas fa-envelope"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    </main>

    <!-- Toast Notification -->
    <div class="toast" id="toast">
        <div class="toast-content">
            <i class="fas fa-check-circle"></i>
            <span class="toast-message">Resume opened in a new tab</span>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p>&copy; <span class="footer-year">2025</span> Mohamed Aiman | <a href="/privacy" class="footer-link">privacy?</a></p>
        </div>
    </footer>

    <script src="/vendor/lenis/lenis.min.js"></script>
    <script src="/js/app.min.js"></script>
</body>
</html>
