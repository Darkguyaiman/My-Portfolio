<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= seo.title %></title>
    <meta name="description" content="<%= seo.description %>">
    <meta name="author" content="Mohamed Aiman">
    <meta name="robots" content="<%= seo.robots %>">
    <meta name="theme-color" content="#1a1a1c">
    <meta name="color-scheme" content="dark light">
    <meta name="referrer" content="strict-origin-when-cross-origin">

    <!-- Open Graph powers previews on Reddit, LinkedIn, Facebook, and other social platforms. -->
    <meta property="og:type" content="<%= seo.type %>">
    <meta property="og:site_name" content="Mohamed Aiman Portfolio">
    <meta property="og:locale" content="en_MY">
    <meta property="og:url" content="<%= seo.canonical %>">
    <meta property="og:title" content="<%= seo.title %>">
    <meta property="og:description" content="<%= seo.description %>">
    <meta property="og:image" content="<%= seo.image %>">
    <% if (seo.imageType) { %><meta property="og:image:type" content="<%= seo.imageType %>"><% } %>
    <% if (seo.imageWidth) { %><meta property="og:image:width" content="<%= seo.imageWidth %>"><% } %>
    <% if (seo.imageHeight) { %><meta property="og:image:height" content="<%= seo.imageHeight %>"><% } %>
    <meta property="og:image:alt" content="<%= seo.imageAlt %>">
    <meta property="profile:first_name" content="Mohamed">
    <meta property="profile:last_name" content="Aiman">
    <meta property="profile:username" content="Darkguyaiman">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@MohamedAiman103">
    <meta name="twitter:creator" content="@MohamedAiman103">
    <meta name="twitter:title" content="<%= seo.title %>">
    <meta name="twitter:description" content="<%= seo.description %>">
    <meta name="twitter:image" content="<%= seo.image %>">
    <meta name="twitter:image:alt" content="<%= seo.imageAlt %>">

    <link rel="canonical" href="<%= seo.canonical %>">
    <link rel="sitemap" type="application/xml" href="/sitemap.xml">
    <link rel="alternate" type="application/json" href="/portfolio.json" title="Machine-readable portfolio">
    <link rel="alternate" type="text/plain" href="/llms.txt" title="AI-readable site summary">
    <%~ include('partials/head-icons') %>
    <script type="application/ld+json"><%~ seo.jsonLd %></script>
    <script>
        (function() {
            const savedTheme = localStorage.getItem('theme') || 'dark';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
    <style>html{background:#fdfbf7}html[data-theme="dark"]{background:#1a1a1c}</style>
    <link rel="preload" href="/vendor/fonts/inter/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" as="image" href="/assets/optimized/Mohamed%20Aiman%20Alter%20Ego-440.webp" imagesrcset="/assets/optimized/Mohamed%20Aiman%20Alter%20Ego-220.webp 220w, /assets/optimized/Mohamed%20Aiman%20Alter%20Ego-440.webp 440w, /assets/optimized/Mohamed%20Aiman%20Alter%20Ego-680.webp 680w" imagesizes="(max-width: 360px) 180px, (max-width: 768px) 220px, (min-width: 1400px) 340px, (min-width: 1200px) 320px, (min-width: 1024px) 300px, 280px" fetchpriority="high">
    <link rel="stylesheet" href="/css/home-page.min.css?v=<%= assetVersion %>">
    <noscript><link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= assetVersion %>"><link rel="stylesheet" href="/vendor/devicon/devicon-subset.css?v=<%= assetVersion %>"></noscript>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="nav-container">
            <div class="logo">
                <a href="#home" class="logo-link">Darkguyaiman</a>
                <!-- Easter Egg Modal -->
                <div class="easter-egg" id="easterEgg">
                    <div class="easter-egg-content">
                        <div class="easter-egg-image-container">
                            <img src="/assets/optimized/2D%20Mohamed-240.webp" srcset="/assets/optimized/2D%20Mohamed-240.webp 1x, /assets/optimized/2D%20Mohamed-480.webp 2x" alt="2D Mohamed" class="easter-egg-image" width="240" height="240" loading="lazy" decoding="async">
                        </div>
                        <div class="easter-egg-name">darkguyaiman</div>
                        <div class="easter-egg-message" id="easterEggMessage"></div>
                    </div>
                </div>
            </div>
            <ul class="nav-menu" id="navMenu">
                <li class="nav-close-container">
                    <button class="nav-close-btn" id="navCloseBtn" aria-label="Close menu">
                        <i class="fas fa-times"></i>
                    </button>
                </li>
                <li><a href="#home" class="nav-link">home</a></li>
                <li><a href="#projects" class="nav-link">projects</a></li>
                <li><a href="#work" class="nav-link">work</a></li>
                <li><a href="#education" class="nav-link">education</a></li>
                <li><a href="#languages" class="nav-link">languages</a></li>
                <li><a href="#contact" class="nav-link">contact</a></li>
                <li class="nav-image-container">
                    <div class="nav-image-wrapper">
                        <div class="nav-greeting-wrapper">
                            <span class="nav-greeting" id="navGreeting"></span>
                        </div>
                        <div class="nav-image-content">
                            <div class="nav-image-glow"></div>
                            <img src="/assets/optimized/2D%20Mohamed%20Leaning-240.webp" srcset="/assets/optimized/2D%20Mohamed%20Leaning-240.webp 1x, /assets/optimized/2D%20Mohamed%20Leaning-480.webp 2x" alt="2D Mohamed Leaning" class="nav-leaning-image" width="240" height="240" loading="lazy" decoding="async">
                            <div class="nav-name">darkguyaiman</div>
                        </div>
                    </div>
                </li>
            </ul>
            <div class="nav-controls">
                <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme">
                    <i class="fas fa-sun" id="themeIcon"></i>
                </button>
                <div class="hamburger" id="hamburger">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
        </div>
    </nav>

    <main>
    <!-- Hero Section -->
    <section id="home" class="hero">
        <div class="container">
            <div class="hero-content">
                <div class="hero-text">
                    <h1 class="hero-title"><%= content.heroTitlePrefix %> <span class="name-highlight"><%= content.heroName %>.</span></h1>
                    <p class="hero-subtitle hero-line"><%~ content.heroSubtitle %></p>
                    <p class="hero-description hero-line">
                        <%= content.heroDescription %>
                    </p>
                    <div class="hero-links">
                        <a href="<%= content.resumePath %>" target="_blank" class="resume-link" id="resumeLink">
                            <i class="fas fa-file-pdf"></i>
                            Resume
                        </a>
                        <div class="icon-dock social-links" role="navigation" aria-label="Social links">
                            <a href="<%= content.linkedinUrl %>" target="_blank" class="dock-icon" data-label="LinkedIn" aria-label="LinkedIn"><i class="fab fa-linkedin"></i></a>
                            <a href="<%= content.githubUrl %>" target="_blank" class="dock-icon" data-label="GitHub" aria-label="GitHub"><i class="fab fa-github"></i></a>
                            <a href="<%= content.xUrl %>" target="_blank" class="dock-icon" data-label="X" aria-label="X (Twitter)"><i class="fab fa-x-twitter"></i></a>
                            <a href="<%= content.instagramUrl %>" target="_blank" class="dock-icon" data-label="Instagram" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                            <a href="<%= content.facebookUrl %>" target="_blank" class="dock-icon" data-label="Facebook" aria-label="Facebook"><i class="fab fa-facebook"></i></a>
                            <a href="mailto:<%= content.email %>" class="dock-icon" data-label="Email" aria-label="Email"><i class="fas fa-envelope"></i></a>
                        </div>
                    </div>
                </div>
                <div class="hero-image-container">
                    <div class="image-wrapper">
                        <img src="/assets/optimized/Mohamed%20Aiman-440.webp" srcset="/assets/optimized/Mohamed%20Aiman-220.webp 220w, /assets/optimized/Mohamed%20Aiman-440.webp 440w, /assets/optimized/Mohamed%20Aiman-680.webp 680w" sizes="(max-width: 360px) 180px, (max-width: 768px) 220px, (min-width: 1400px) 340px, (min-width: 1200px) 320px, (min-width: 1024px) 300px, 280px" alt="Mohamed Aiman" class="profile-image" id="profileImage" width="680" height="680" decoding="async" fetchpriority="low">
                        <img src="/assets/optimized/Mohamed%20Aiman%20Alter%20Ego-440.webp" srcset="/assets/optimized/Mohamed%20Aiman%20Alter%20Ego-220.webp 220w, /assets/optimized/Mohamed%20Aiman%20Alter%20Ego-440.webp 440w, /assets/optimized/Mohamed%20Aiman%20Alter%20Ego-680.webp 680w" sizes="(max-width: 360px) 180px, (max-width: 768px) 220px, (min-width: 1400px) 340px, (min-width: 1200px) 320px, (min-width: 1024px) 300px, 280px" alt="Mohamed Aiman Alter Ego" class="profile-image alter-ego" id="alterEgoImage" width="680" height="680" decoding="async" fetchpriority="high">
                        <div class="image-glow"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Skills Section -->
    <section class="skills">
        <div class="container">
            <h2 class="section-title">My Specialities</h2>
            <div class="skills-grid">
                <div class="skill-item" data-skill="nextjs">
                    <i class="devicon-nextjs-plain colored"></i>
                    <span class="skill-name">Next.js</span>
                    <span class="skill-number"></span>
                </div>
                <div class="skill-item" data-skill="react">
                    <i class="devicon-react-original colored"></i>
                    <span class="skill-name">React</span>
                    <span class="skill-number"></span>
                </div>
                <div class="skill-item" data-skill="nginx">
                    <i class="devicon-nginx-original colored"></i>
                    <span class="skill-name">Nginx</span>
                    <span class="skill-number"></span>
                </div>
                <div class="skill-item" data-skill="ubuntu">
                    <i class="fa-brands fa-ubuntu colored"></i>
                    <span class="skill-name">Ubuntu</span>
                    <span class="skill-number"></span>
                </div>
                <div class="skill-item" data-skill="typescript">
                    <i class="devicon-typescript-plain colored"></i>
                    <span class="skill-name">TypeScript</span>
                    <span class="skill-number"></span>
                </div>
                <div class="skill-item" data-skill="googlecloud">
                    <i class="devicon-googlecloud-plain colored"></i>
                    <span class="skill-name">Google Cloud</span>
                    <span class="skill-number"></span>
                </div>
                <div class="skill-item" data-skill="html">
                    <i class="devicon-html5-plain colored"></i>
                    <span class="skill-name">HTML</span>
                    <span class="skill-number"></span>
                </div>
                <div class="skill-item" data-skill="css">
                    <i class="devicon-css3-plain colored"></i>
                    <span class="skill-name">CSS</span>
                    <span class="skill-number"></span>
                </div>
                <div class="skill-item" data-skill="javascript">
                    <i class="devicon-javascript-plain colored"></i>
                    <span class="skill-name">JavaScript</span>
                    <span class="skill-number"></span>
                </div>
                <div class="skill-item" data-skill="node">
                    <i class="fa-brands fa-node-js colored"></i>
                    <span class="skill-name">Node</span>
                    <span class="skill-number"></span>
                </div>
                <div class="skill-item" data-skill="express">
                    <i class="devicon-express-original colored"></i>
                    <span class="skill-name">Express</span>
                    <span class="skill-number"></span>
                </div>
                <div class="skill-item" data-skill="mysql">
                    <i class="devicon-mysql-plain colored"></i>
                    <span class="skill-name">MySQL</span>
                    <span class="skill-number"></span>
                </div>
                <div class="skill-item" data-skill="jquery">
                    <i class="devicon-jquery-plain colored"></i>
                    <span class="skill-name">jQuery</span>
                    <span class="skill-number"></span>
                </div>
                <div class="skill-item" data-skill="ejs">
                    <span class="ejs-icon">EJS</span>
                    <span class="skill-name">EJS</span>
                    <span class="skill-number"></span>
                </div>
                <div class="skill-item" data-skill="tailwind">
                    <i class="devicon-tailwindcss-plain colored"></i>
                    <span class="skill-name">Tailwind</span>
                    <span class="skill-number"></span>
                </div>
            </div>
        </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="projects">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">featured projects</h2>
                <a href="/projects" class="view-more">view more <i class="fas fa-chevron-right"></i></a>
            </div>
            <div class="projects-grid" id="projectsGrid" data-server-rendered="true">
                <% projects.forEach(function(project) { %>
                <% const displayImages = (project.images || []).slice(0, 3); %>
                <article class="project-card">
                    <a href="/projects/<%= project.slug %>" class="project-card-main-link">View <%= project.projectName %> details</a>
                    <% if (displayImages.length) { %>
                    <div class="project-card-images">
                        <% displayImages.forEach(function(image) { %>
                        <img src="/<%= projectThumbnail(image) %>" alt="Screenshot of <%= project.projectName %>" class="project-card-image" loading="lazy" decoding="async">
                        <% }) %>
                        <% if ((project.images || []).length > 3) { %>
                        <div class="project-card-image-more" role="img" aria-label="<%= project.images.length - 3 %> more screenshots">+<%= project.images.length - 3 %></div>
                        <% } %>
                    </div>
                    <% } %>
                    <h3 class="project-title"><%= project.projectName %></h3>
                    <div class="project-links">
                        <% if (project.deployedLink) { %><a href="<%= project.deployedLink %>" target="_blank" rel="noopener noreferrer" class="project-link" aria-label="View <%= project.projectName %> website">Website</a><% } %>
                        <% if (project.githubLink) { %><a href="<%= project.githubLink %>" target="_blank" rel="noopener noreferrer" class="project-link" aria-label="View <%= project.projectName %> on GitHub">Github</a><% } %>
                        <a href="/projects/<%= project.slug %>" class="project-link" aria-label="View <%= project.projectName %> details">Details</a>
                    </div>
                    <p class="project-description"><%= project.description %></p>
                    <div class="project-tags" role="group" aria-label="Technologies used">
                        <% project.techUsed.forEach(function(technology) { %>
                        <% const iconClass = techIcon(technology); %>
                        <% if (iconClass) { %><i class="project-tech-icon <%= iconClass %>" data-tooltip="<%= technology %>" aria-label="<%= technology %>"></i><% } else if (technology === 'EJS') { %><span class="project-tech-icon ejs-icon-small" data-tooltip="EJS">EJS</span><% } else { %><span class="project-tech-icon-fallback" data-tooltip="<%= technology %>"><%= technology %></span><% } %>
                        <% }) %>
                    </div>
                </article>
                <% }) %>
            </div>
        </div>
    </section>

    <!-- Work Section -->
    <section id="work" class="work">
        <div class="container">
            <h2 class="section-title">Work</h2>
            <div class="timeline" id="workTimeline" data-server-rendered="true">
                <% workExperiences.forEach(function(job) { %>
                <article class="timeline-item" data-start="<%= job.startDate %>" data-end="<%= job.endDate %>">
                    <div class="timeline-marker">
                        <% if (job.logo) { %><img src="/<%= optimizedAsset(job.logo, 256) %>" alt="<%= job.company %> logo" class="timeline-logo" loading="lazy" decoding="async"><% } %>
                    </div>
                    <div class="timeline-content">
                        <div class="timeline-date">
                            <span class="timeline-date-text"><%= formatMonthYear(job.startDate) %> - <%= formatMonthYear(job.endDate) %></span>
                            <span class="timeline-duration" data-duration="<%= job.startDate %>-<%= job.endDate %>"></span>
                            <% if (job.endDate === 'present') { %><span class="timeline-current-badge">Current</span><% } %>
                        </div>
                        <h3 class="timeline-company"><%= job.company %></h3>
                        <div class="timeline-role"><%= job.role %></div>
                        <ul class="timeline-description">
                            <% job.description.forEach(function(description) { %><li><%= description %></li><% }) %>
                        </ul>
                    </div>
                </article>
                <% }) %>
            </div>
        </div>
    </section>

    <!-- Education Section -->
    <section id="education" class="education">
        <div class="container">
            <h2 class="section-title">Education</h2>
            <div class="timeline" id="educationTimeline" data-server-rendered="true">
                <% education.forEach(function(edu) { %>
                <% const logoPath = institutionLogo(edu.institution); %>
                <article class="timeline-item" data-start="<%= edu.duration.start %>" data-end="<%= edu.duration.end %>">
                    <div class="timeline-marker">
                        <% if (logoPath) { %><img src="/<%= optimizedAsset(logoPath, 192) %>" alt="<%= edu.institution %> logo" class="timeline-logo" loading="lazy" decoding="async"><% } else { %><i class="fas fa-graduation-cap" aria-hidden="true"></i><% } %>
                    </div>
                    <div class="timeline-content">
                        <div class="timeline-date"><span class="timeline-date-text"><%= edu.duration.start %> - <%= edu.duration.end %></span></div>
                        <h3 class="timeline-company"><%= edu.qualification %></h3>
                        <div class="timeline-role"><%= edu.institution %></div>
                        <div class="timeline-field"><%= edu.field %></div>
                        <% if (edu.results && edu.results.grades) { %>
                        <div class="timeline-results"><span class="timeline-results-text"><%= edu.results.total_subjects %> subjects: <%= Object.entries(edu.results.grades).map(function(entry) { return entry[1] + ' ' + entry[0] + (entry[1] > 1 ? 's' : ''); }).join(', ') %></span></div>
                        <% } else if (edu.results && (edu.results.semester != null || edu.results.gpa != null)) { %>
                        <div class="timeline-results"><span class="timeline-results-text"><% if (edu.results.semester != null) { %>Semester <%= edu.results.semester %><% } %><% if (edu.results.semester != null && edu.results.gpa != null) { %> · <% } %><% if (edu.results.gpa != null) { %><%= Number(edu.results.gpa).toFixed(1) %> GPA<% } %></span></div>
                        <% } %>
                        <p class="timeline-description-text"><%= edu.description %></p>
                    </div>
                </article>
                <% }) %>
            </div>
        </div>
    </section>

    <!-- Languages Section -->
    <section id="languages" class="languages">
        <div class="container">
            <h2 class="section-title">I speak these human languages</h2>
            <div class="languages-grid" id="languagesGrid" data-server-rendered="true">
                <% languages.forEach(function(language) { %>
                <div class="language-item">
                    <div class="language-name"><%= language.name %></div>
                    <div class="language-level <%= language.level.toLowerCase().replace(/\s+/g, '-') %>"><%= language.level %></div>
                </div>
                <% }) %>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="contact">
        <div class="container">
            <div class="contact-content">
                <h2 class="section-title contact-title">contact</h2>
                <div class="contact-wrapper">
                    <p class="contact-text">
                        <%= content.contactText %>
                    </p>
                    <div class="icon-dock contact-links" role="navigation" aria-label="Contact links">
                        <a href="<%= content.linkedinUrl %>" target="_blank" class="dock-icon" data-label="LinkedIn" aria-label="LinkedIn"><i class="fab fa-linkedin"></i></a>
                        <a href="<%= content.githubUrl %>" target="_blank" class="dock-icon" data-label="GitHub" aria-label="GitHub"><i class="fab fa-github"></i></a>
                        <a href="<%= content.xUrl %>" target="_blank" class="dock-icon" data-label="X" aria-label="X (Twitter)"><i class="fab fa-x-twitter"></i></a>
                        <a href="<%= content.instagramUrl %>" target="_blank" class="dock-icon" data-label="Instagram" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                        <a href="<%= content.facebookUrl %>" target="_blank" class="dock-icon" data-label="Facebook" aria-label="Facebook"><i class="fab fa-facebook"></i></a>
                        <a href="mailto:<%= content.email %>" class="dock-icon" data-label="Email" aria-label="Email"><i class="fas fa-envelope"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    </main>

    <!-- Toast Notification -->
    <div class="toast" id="toast">
        <div class="toast-content">
            <i class="fas fa-check-circle"></i>
            <span class="toast-message">Resume opened in a new tab</span>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p>&copy; <span class="footer-year">2025</span> Mohamed Aiman | <a href="/privacy" class="footer-link">privacy?</a></p>
        </div>
    </footer>

    <script src="/js/app.min.js?v=<%= assetVersion %>"></script>
</body>
</html>
