<!--
  THESIS: Floating Ai-man companion — Tidio-style chat chrome, portfolio colors, brown blobatar.
  OWN-WORLD: cream/dark + red header; warm brown face; Inter body, Press Start name.
  STORY: Visitors ask about Mohamed; Ai-man answers; face tracks pointer and escalates on pokes.
  FIRST VIEWPORT: Free-floating launcher; panel opens above with solid header and persistent input.
  FORM: Local extension of public Experience surfaces; inherits Darkguyaiman identity.
-->
<link rel="stylesheet" href="/vendor/blobatar/motion.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/vendor/blobatar/gaze.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/dark-ai-chat.min.css?v=<%= assetVersion %>">

<div class="dark-ai" id="darkAiRoot" data-seed="">
  <div class="dark-ai-panel" id="darkAiPanel" hidden>
    <header class="dark-ai-header">
      <div class="dark-ai-identity">
        <div class="dark-ai-face-tip" id="darkAiFaceTip" data-tooltip="Ai-man" role="img" aria-label="Ai-man">
          <div class="dark-ai-face-slot dark-ai-face-slot--header" id="darkAiFaceHeader" aria-hidden="true"></div>
        </div>
        <div class="dark-ai-identity-copy">
          <p class="dark-ai-name">Ai-man</p>
          <p class="dark-ai-status" id="darkAiStatus">
            <span class="dark-ai-online-dot" aria-hidden="true"></span>
            <span id="darkAiStatusText">We're online</span>
          </p>
        </div>
      </div>
      <div class="dark-ai-header-actions">
        <button
          type="button"
          class="dark-ai-icon-btn dark-ai-close"
          id="darkAiClose"
          aria-label="Minimize chat"
          data-tooltip="Minimize"
        >
          <i class="fas fa-chevron-down" aria-hidden="true"></i>
        </button>
      </div>
      <div class="dark-ai-header-wave" aria-hidden="true">
        <svg class="dark-ai-header-wave-svg" viewBox="0 0 2880 48" preserveAspectRatio="none">
          <path
            fill="currentColor"
            d="M0 28
               C360 28 360 8 720 8
               C1080 8 1080 28 1440 28
               C1800 28 1800 8 2160 8
               C2520 8 2520 28 2880 28
               V48 H0 Z"
          ></path>
        </svg>
      </div>
    </header>

    <div class="dark-ai-messages" id="darkAiMessages" role="log" aria-live="polite" aria-relevant="additions">
      <div class="dark-ai-bubble dark-ai-bubble--bot dark-ai-bubble--enter">
        <p>Hey — I&rsquo;m <strong>Ai-man</strong>. Ask about Mohamed&rsquo;s skills, projects, experience, or salary expectations.</p>
      </div>
      <div class="dark-ai-quick-replies" id="darkAiQuickReplies">
        <button type="button" class="dark-ai-chip dark-ai-chip--solid" data-prompt="What tech is Mohamed familiar with?">Skills</button>
        <button type="button" class="dark-ai-chip" data-prompt="What are his salary expectations?">Salary</button>
        <button type="button" class="dark-ai-chip" data-prompt="Tell me about his MySQL experience">MySQL</button>
        <button type="button" class="dark-ai-chip" data-prompt="Is the DDOS-easy project any good?">DDOS-easy</button>
      </div>
    </div>

    <form class="dark-ai-form" id="darkAiForm" autocomplete="off">
      <label class="visually-hidden" for="darkAiInput">Message Ai-man</label>
      <textarea
        id="darkAiInput"
        class="dark-ai-input"
        rows="1"
        maxlength="1200"
        placeholder="Enter your message..."
      ></textarea>
      <button
        type="submit"
        class="dark-ai-send"
        id="darkAiSend"
        aria-label="Send message"
      >
        <i class="fas fa-paper-plane" aria-hidden="true"></i>
      </button>
    </form>
  </div>

  <button
    type="button"
    class="dark-ai-launcher"
    id="darkAiLauncher"
    aria-expanded="false"
    aria-controls="darkAiPanel"
    aria-label="Open Ai-man chat"
    data-tooltip="Chat with Ai-man"
  >
    <span class="dark-ai-face-slot dark-ai-face-slot--launcher" id="darkAiFace" aria-hidden="true"></span>
  </button>
</div>

<script src="/js/dark-ai-chat.min.js?v=<%= assetVersion %>" defer></script>
