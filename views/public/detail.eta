<!DOCTYPE html>
<html lang="en" data-theme="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= seo.title %></title>
    <meta name="description" content="<%= seo.description %>">
    <meta name="author" content="Mohamed Aiman">
    <meta name="robots" content="<%= seo.robots %>">
    <meta name="theme-color" content="#1a1a1c">
    <meta name="color-scheme" content="dark light">
    <meta name="referrer" content="strict-origin-when-cross-origin">

    <!-- Open Graph powers previews on Reddit and other social platforms. -->
    <meta property="og:type" content="<%= seo.type %>">
    <meta property="og:site_name" content="Mohamed Aiman Portfolio">
    <meta property="og:locale" content="en_MY">
    <meta property="og:url" content="<%= seo.canonical %>">
    <meta property="og:title" content="<%= seo.title %>">
    <meta property="og:description" content="<%= seo.description %>">
    <meta property="og:image" content="<%= seo.image %>">
    <% if (seo.imageType) { %><meta property="og:image:type" content="<%= seo.imageType %>"><% } %>
    <% if (seo.imageWidth) { %><meta property="og:image:width" content="<%= seo.imageWidth %>"><% } %>
    <% if (seo.imageHeight) { %><meta property="og:image:height" content="<%= seo.imageHeight %>"><% } %>
    <meta property="og:image:alt" content="<%= seo.imageAlt %>">
    <% (seo.tags || []).forEach(function(tag) { %><meta property="article:tag" content="<%= tag %>"><% }) %>

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@MohamedAiman103">
    <meta name="twitter:creator" content="@MohamedAiman103">
    <meta name="twitter:title" content="<%= seo.title %>">
    <meta name="twitter:description" content="<%= seo.description %>">
    <meta name="twitter:image" content="<%= seo.image %>">
    <meta name="twitter:image:alt" content="<%= seo.imageAlt %>">

    <link rel="canonical" href="<%= seo.canonical %>">
    <link rel="sitemap" type="application/xml" href="/sitemap.xml">
    <link rel="alternate" type="application/json" href="/portfolio.json" title="Machine-readable portfolio">
    <link rel="alternate" type="text/plain" href="/llms.txt" title="AI-readable site summary">
    <%~ include('partials/head-icons') %>
    <script type="application/ld+json"><%~ seo.jsonLd %></script>
    <script>
        (function () {
            const savedTheme = localStorage.getItem('theme') || 'dark';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
    <style>html{background:#fdfbf7}html[data-theme="dark"]{background:#1a1a1c}</style>
    <link rel="preload" href="/vendor/fonts/inter/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
    <% if (project && project.images && project.images[0]) { const leadImage = projectImageSources(project.images[0]); %>
    <link rel="preload" as="image" href="/<%= leadImage.src %>"<% if (leadImage.srcset) { %> imagesrcset="<%= leadImage.srcset %>" imagesizes="<%= leadImage.sizes %>"<% } %> fetchpriority="high">
    <% } %>
    <link rel="stylesheet" href="/css/detail-page.min.css?v=<%= assetVersion %>">
    <noscript><link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= assetVersion %>"><link rel="stylesheet" href="/vendor/devicon/devicon-subset.css?v=<%= assetVersion %>"></noscript>
</head>

<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="nav-container">
            <div class="logo">
                <a href="/" class="logo-link">Darkguyaiman</a>
                <!-- Easter Egg Modal -->
                <div class="easter-egg" id="easterEgg">
                    <div class="easter-egg-content">
                        <div class="easter-egg-image-container">
                            <img src="/assets/optimized/2D%20Mohamed-240.webp" srcset="/assets/optimized/2D%20Mohamed-240.webp 1x, /assets/optimized/2D%20Mohamed-480.webp 2x" alt="2D Mohamed" class="easter-egg-image" width="240" height="240" loading="lazy" decoding="async">
                        </div>
                        <div class="easter-egg-name">darkguyaiman</div>
                        <div class="easter-egg-message" id="easterEggMessage"></div>
                    </div>
                </div>
            </div>
            <ul class="nav-menu" id="navMenu">
                <li class="nav-close-container">
                    <button class="nav-close-btn" id="navCloseBtn" aria-label="Close menu">
                        <i class="fas fa-times"></i>
                    </button>
                </li>
                <li><a href="/#home" class="nav-link">home</a></li>
                <li><a href="/#projects" class="nav-link">projects</a></li>
                <li><a href="/#work" class="nav-link">work</a></li>
                <li><a href="/#education" class="nav-link">education</a></li>
                <li><a href="/#languages" class="nav-link">languages</a></li>
                <li><a href="/#contact" class="nav-link">contact</a></li>
                <li class="nav-image-container">
                    <div class="nav-image-wrapper">
                        <div class="nav-greeting-wrapper">
                            <span class="nav-greeting" id="navGreeting"></span>
                        </div>
                        <div class="nav-image-content">
                            <div class="nav-image-glow"></div>
                            <img src="/assets/optimized/2D%20Mohamed%20Leaning-240.webp" srcset="/assets/optimized/2D%20Mohamed%20Leaning-240.webp 1x, /assets/optimized/2D%20Mohamed%20Leaning-480.webp 2x" alt="2D Mohamed Leaning"
                                class="nav-leaning-image" width="240" height="240" loading="lazy" decoding="async">
                            <div class="nav-name">darkguyaiman</div>
                        </div>
                    </div>
                </li>
            </ul>
            <div class="nav-controls">
                <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme">
                    <i class="fas fa-sun" id="themeIcon"></i>
                </button>
                <div class="hamburger" id="hamburger">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
        </div>
    </nav>

    <main>
        <!-- Project Detail Section -->
        <section class="project-detail">
            <div class="container">
                <a href="/projects" class="back-link">
                    <i class="fas fa-chevron-left"></i>
                    <span>back to projects</span>
                </a>

                <% if (project) { %>
                <div class="project-detail-header">
                    <h1 class="project-detail-title" id="projectTitle"><%= project.projectName %></h1>
                    <div class="project-detail-links" id="projectLinks"<% if (!project.deployedLink && !project.githubLink) { %> hidden<% } %>>
                        <% if (project.deployedLink) { %><a href="<%= project.deployedLink %>" target="_blank" rel="noopener noreferrer" class="project-link" aria-label="View <%= project.projectName %> website"><i class="fas fa-external-link-alt" aria-hidden="true"></i><span>Website</span></a><% } %>
                        <% if (project.githubLink) { %><a href="<%= project.githubLink %>" target="_blank" rel="noopener noreferrer" class="project-link" aria-label="View <%= project.projectName %> on GitHub"><i class="fab fa-github" aria-hidden="true"></i><span>Github</span></a><% } %>
                    </div>
                    <p class="project-detail-description" id="projectDescription"><%= project.description %></p>
                </div>

                <div class="project-detail-images" id="projectImages">
                    <% (project.images || []).forEach(function(image, index) { %>
                    <% const imageSource = projectImageSources(image); %>
                    <img src="/<%= imageSource.src %>"<% if (imageSource.srcset) { %> srcset="<%= imageSource.srcset %>" sizes="<%= imageSource.sizes %>"<% } %><% if (imageSource.width && imageSource.height) { %> width="<%= imageSource.width %>" height="<%= imageSource.height %>"<% } %> alt="<%= project.projectName %> screenshot <%= index + 1 %>" class="project-detail-image" data-image-index="<%= index %>" loading="<%= index < 2 ? 'eager' : 'lazy' %>" decoding="async" fetchpriority="<%= index < 2 ? 'high' : 'low' %>">
                    <% }) %>
                </div>

                <div class="project-detail-tech">
                    <h2 class="section-title" style="margin-bottom: 1rem;">technologies used</h2>
                    <div class="project-tech-icons" id="projectTech">
                        <% project.techUsed.forEach(function(technology) { const iconClass = techIcon(technology); const techKey = technology.toLowerCase().replace(/\s+/g, '').replace('.', ''); %><div class="tech-icon-item" data-tech="<%= techKey %>"><% if (iconClass) { %><i class="<%= iconClass %>" aria-hidden="true"></i><% } else if (technology === 'EJS') { %><span class="ejs-icon" aria-hidden="true">EJS</span><% } %><span class="tech-icon-name"><%= technology %></span></div><% }) %>
                    </div>
                </div>
                <% } else { %>
                <div class="project-detail-header">
                    <h1 class="project-detail-title">Project not found</h1>
                    <p class="project-detail-description">This project may have moved or no longer exists. Browse the current projects instead.</p>
                </div>
                <% } %>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p>&copy; <span class="footer-year">2025</span> Mohamed Aiman | <a href="/privacy"
                    class="footer-link">privacy?</a></p>
        </div>
    </footer>

    <!-- Image Modal -->
    <div class="image-modal" id="imageModal" role="dialog" aria-modal="true" aria-label="Image viewer" hidden>
        <button type="button" class="image-modal-btn image-modal-close" id="modalClose" aria-label="Close image viewer">
            <i class="fas fa-times" aria-hidden="true"></i>
        </button>
        <button type="button" class="image-modal-btn image-modal-nav image-modal-prev" id="modalPrev" aria-label="Previous image">
            <i class="fas fa-chevron-left" aria-hidden="true"></i>
        </button>
        <button type="button" class="image-modal-btn image-modal-nav image-modal-next" id="modalNext" aria-label="Next image">
            <i class="fas fa-chevron-right" aria-hidden="true"></i>
        </button>
        <div class="image-modal-stage" id="modalStage">
            <div class="image-modal-content" id="modalContent">
                <img class="image-modal-img" id="modalImage" src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" alt="" decoding="async">
            </div>
        </div>
        <div class="image-modal-toolbar">
            <div class="image-modal-zoom">
                <button type="button" class="image-modal-btn image-modal-zoom-btn" id="modalZoomOut" aria-label="Zoom out">
                    <i class="fas fa-minus" aria-hidden="true"></i>
                </button>
                <span class="image-modal-zoom-level" id="modalZoomLevel">100%</span>
                <button type="button" class="image-modal-btn image-modal-zoom-btn" id="modalZoomIn" aria-label="Zoom in">
                    <i class="fas fa-plus" aria-hidden="true"></i>
                </button>
                <button type="button" class="image-modal-btn image-modal-zoom-btn image-modal-reset" id="modalZoomReset" aria-label="Reset zoom">
                    <i class="fas fa-compress" aria-hidden="true"></i>
                </button>
            </div>
            <div class="image-modal-counter" id="modalCounter"></div>
        </div>
    </div>

    <script src="/js/app.min.js?v=<%= assetVersion %>"></script>
    <script>
        let currentImageIndex = 0;
        let projectImages = [];
        let zoomLevel = 1;
        let panX = 0;
        let panY = 0;
        let uiRaf = 0;
        let isGesturing = false;
        let suppressClickUntil = 0;
        let activePanId = null;
        // Pointer capture retargets click to the modal — track the real down target.
        let pointerDownOnImage = false;
        let backdropDismissId = null;
        let touchOnControls = false;

        const pointers = new Map();
        let gesture = null;

        function isModalControl(target) {
            return Boolean(target?.closest?.('.image-modal-btn, .image-modal-toolbar'));
        }

        let lastTapAt = 0;
        let lastTapX = 0;
        let lastTapY = 0;

        const ZOOM_MIN = 1;
        const ZOOM_MAX = 6;
        const ZOOM_STEP = 0.45;
        // Touch pinch: zoom gain per pixel of finger spread.
        const PINCH_PIXEL_SCALE = 0.032;
        // Desktop wheel / two-finger scroll zoom. Higher = faster.
        const WHEEL_ZOOM_SCALE = 0.0075;
        // Trackpad pinch (usually reported as ctrl+wheel).
        const TRACKPAD_PINCH_SCALE = 0.028;
        const DOUBLE_TAP_MS = 280;
        const DOUBLE_TAP_SLOP = 28;

        let gestureStartZoom = 1;

        function clampZoom(value) {
            return Math.min(ZOOM_MAX, Math.max(ZOOM_MIN, value));
        }

        function roundZoom(value) {
            return Math.round(value * 100) / 100;
        }

        function getStageCenter() {
            const stage = document.getElementById('modalStage');
            const rect = stage.getBoundingClientRect();
            return {
                x: rect.left + rect.width / 2,
                y: rect.top + rect.height / 2
            };
        }

        function pointerDistance(a, b) {
            return Math.hypot(a.x - b.x, a.y - b.y);
        }

        function pointerMidpoint(a, b) {
            return {
                x: (a.x + b.x) / 2,
                y: (a.y + b.y) / 2
            };
        }

        function applyImageTransform() {
            const modalImg = document.getElementById('modalImage');
            modalImg.style.transform = `translate3d(${panX}px, ${panY}px, 0) scale(${zoomLevel})`;
        }

        function setGesturing(active) {
            const modalImg = document.getElementById('modalImage');
            isGesturing = active;
            modalImg.classList.toggle('is-gesturing', active);
            modalImg.classList.toggle('is-panning', active && gesture?.type === 'pan');
            if (active) {
                modalImg.classList.remove('is-animating');
            }
        }

        function updateZoomUi() {
            const modal = document.getElementById('imageModal');
            const modalContent = document.getElementById('modalContent');
            const zoomLabel = document.getElementById('modalZoomLevel');
            const zoomOutBtn = document.getElementById('modalZoomOut');
            const zoomInBtn = document.getElementById('modalZoomIn');
            const zoomResetBtn = document.getElementById('modalZoomReset');
            const zoomed = zoomLevel > 1.001;

            modalContent.classList.toggle('is-zoomed', zoomed);
            modal.classList.toggle('is-zoomed', zoomed);
            zoomLabel.textContent = `${Math.round(zoomLevel * 100)}%`;
            zoomOutBtn.disabled = zoomLevel <= ZOOM_MIN + 0.001;
            zoomInBtn.disabled = zoomLevel >= ZOOM_MAX - 0.001;
            zoomResetBtn.disabled = !zoomed && Math.abs(panX) < 0.5 && Math.abs(panY) < 0.5;
        }

        function scheduleZoomUi() {
            if (uiRaf) return;
            uiRaf = requestAnimationFrame(() => {
                uiRaf = 0;
                updateZoomUi();
            });
        }

        function setZoom(nextZoom, anchorX, anchorY, options = {}) {
            const animate = options.animate !== false && !isGesturing;
            const prevZoom = zoomLevel;
            const clamped = roundZoom(clampZoom(nextZoom));

            if (Math.abs(clamped - prevZoom) < 0.001 && clamped !== 1) {
                scheduleZoomUi();
                return;
            }

            const modalImg = document.getElementById('modalImage');
            if (animate) {
                modalImg.classList.add('is-animating');
            } else {
                modalImg.classList.remove('is-animating');
            }

            if (clamped <= ZOOM_MIN + 0.001) {
                zoomLevel = 1;
                panX = 0;
                panY = 0;
            } else {
                if (typeof anchorX === 'number' && typeof anchorY === 'number' && prevZoom > 0) {
                    const center = getStageCenter();
                    const offsetX = anchorX - center.x;
                    const offsetY = anchorY - center.y;
                    const ratio = clamped / prevZoom;
                    panX = offsetX - (offsetX - panX) * ratio;
                    panY = offsetY - (offsetY - panY) * ratio;
                }
                zoomLevel = clamped;
            }

            applyImageTransform();
            updateZoomUi();
        }

        function resetZoom(options = {}) {
            pointers.clear();
            gesture = null;
            activePanId = null;
            setGesturing(false);
            setZoom(1, undefined, undefined, { animate: options.animate !== false });
        }

        function zoomIn(anchorX, anchorY) {
            const center = getStageCenter();
            setZoom(zoomLevel + ZOOM_STEP, anchorX ?? center.x, anchorY ?? center.y, { animate: true });
        }

        function zoomOut(anchorX, anchorY) {
            const center = getStageCenter();
            setZoom(zoomLevel - ZOOM_STEP, anchorX ?? center.x, anchorY ?? center.y, { animate: true });
        }

        function beginPan(pointer) {
            activePanId = pointer.id;
            gesture = {
                type: 'pan',
                pointerId: pointer.id,
                startX: pointer.x,
                startY: pointer.y,
                originPanX: panX,
                originPanY: panY,
                moved: false
            };
            setGesturing(true);
        }

        function beginPinch() {
            const pts = Array.from(pointers.values());
            if (pts.length < 2) return;
            const [a, b] = pts;
            const distance = Math.max(pointerDistance(a, b), 1);
            const mid = pointerMidpoint(a, b);
            activePanId = null;
            gesture = {
                type: 'pinch',
                startDistance: distance,
                startZoom: zoomLevel,
                startPanX: panX,
                startPanY: panY,
                originX: mid.x,
                originY: mid.y
            };
            setGesturing(true);
        }

        function updatePan(pointer) {
            if (!gesture || gesture.type !== 'pan') return;
            if (gesture.pointerId != null && pointer.id !== gesture.pointerId) return;

            const dx = pointer.x - gesture.startX;
            const dy = pointer.y - gesture.startY;
            if (Math.hypot(dx, dy) > 2) gesture.moved = true;

            panX = gesture.originPanX + dx;
            panY = gesture.originPanY + dy;
            applyImageTransform();
            scheduleZoomUi();
        }

        function updatePinch() {
            if (!gesture || gesture.type !== 'pinch' || pointers.size < 2) return;
            const [a, b] = Array.from(pointers.values());
            const distance = Math.max(pointerDistance(a, b), 1);
            const mid = pointerMidpoint(a, b);
            const pixelDelta = distance - gesture.startDistance;
            const nextZoom = clampZoom(
                gesture.startZoom * Math.exp(pixelDelta * PINCH_PIXEL_SCALE)
            );
            zoomLevel = nextZoom;

            if (nextZoom <= ZOOM_MIN + 0.001) {
                zoomLevel = 1;
                panX = 0;
                panY = 0;
            } else {
                const center = getStageCenter();
                const startOffsetX = gesture.originX - center.x;
                const startOffsetY = gesture.originY - center.y;
                const midOffsetX = mid.x - center.x;
                const midOffsetY = mid.y - center.y;
                const ratio = nextZoom / gesture.startZoom;
                panX = midOffsetX - (startOffsetX - gesture.startPanX) * ratio;
                panY = midOffsetY - (startOffsetY - gesture.startPanY) * ratio;
            }

            applyImageTransform();
            scheduleZoomUi();
        }

        function syncPointersFromTouches(touchList) {
            pointers.clear();
            for (let i = 0; i < touchList.length; i += 1) {
                const touch = touchList[i];
                pointers.set(touch.identifier, {
                    id: touch.identifier,
                    x: touch.clientX,
                    y: touch.clientY
                });
            }
        }

        function endGesturePointer(pointerId) {
            pointers.delete(pointerId);
            if (activePanId === pointerId) activePanId = null;

            if (pointers.size >= 2) {
                beginPinch();
                return { moved: true, pinched: true };
            }

            if (pointers.size === 1 && zoomLevel > 1.001) {
                beginPan(Array.from(pointers.values())[0]);
                return { moved: true, pinched: true };
            }

            const wasPinch = gesture?.type === 'pinch';
            const moved = Boolean(gesture?.moved);
            gesture = null;
            setGesturing(false);
            zoomLevel = roundZoom(clampZoom(zoomLevel));
            if (zoomLevel <= ZOOM_MIN + 0.001) {
                zoomLevel = 1;
                panX = 0;
                panY = 0;
            }
            applyImageTransform();
            updateZoomUi();

            return { moved, pinched: wasPinch };
        }

        function handleDoubleTap(x, y) {
            if (zoomLevel > 1.05) {
                resetZoom({ animate: true });
            } else {
                setZoom(2.25, x, y, { animate: true });
            }
        }

        function openImageModal(index, images) {
            projectImages = images;
            currentImageIndex = index;
            const modal = document.getElementById('imageModal');
            const modalImg = document.getElementById('modalImage');

            modalImg.src = `/${images[index]}`;
            modalImg.alt = `Project image ${index + 1}`;
            modal.hidden = false;
            modal.classList.add('active');
            document.body.classList.add('image-modal-open');
            resetZoom({ animate: false });
            updateModalCounter();
            updateNavVisibility();
        }

        function closeImageModal() {
            const modal = document.getElementById('imageModal');
            modal.classList.remove('active');
            modal.hidden = true;
            document.body.classList.remove('image-modal-open');
            resetZoom({ animate: false });
        }

        function nextImage() {
            if (projectImages.length <= 1) return;
            currentImageIndex = (currentImageIndex + 1) % projectImages.length;
            const modalImg = document.getElementById('modalImage');
            modalImg.src = `/${projectImages[currentImageIndex]}`;
            modalImg.alt = `Project image ${currentImageIndex + 1}`;
            resetZoom({ animate: false });
            updateModalCounter();
        }

        function prevImage() {
            if (projectImages.length <= 1) return;
            currentImageIndex = (currentImageIndex - 1 + projectImages.length) % projectImages.length;
            const modalImg = document.getElementById('modalImage');
            modalImg.src = `/${projectImages[currentImageIndex]}`;
            modalImg.alt = `Project image ${currentImageIndex + 1}`;
            resetZoom({ animate: false });
            updateModalCounter();
        }

        function updateModalCounter() {
            const modalCounter = document.getElementById('modalCounter');
            modalCounter.textContent = `${currentImageIndex + 1} / ${projectImages.length}`;
        }

        function updateNavVisibility() {
            const modalPrev = document.getElementById('modalPrev');
            const modalNext = document.getElementById('modalNext');
            const showNav = projectImages.length > 1;
            modalPrev.hidden = !showNav;
            modalNext.hidden = !showNav;
        }

        document.addEventListener('DOMContentLoaded', () => {
            const modal = document.getElementById('imageModal');
            const modalImg = document.getElementById('modalImage');
            const modalStage = document.getElementById('modalStage');
            const modalClose = document.getElementById('modalClose');
            const modalPrev = document.getElementById('modalPrev');
            const modalNext = document.getElementById('modalNext');
            const modalZoomIn = document.getElementById('modalZoomIn');
            const modalZoomOut = document.getElementById('modalZoomOut');
            const modalZoomReset = document.getElementById('modalZoomReset');

            const bindControl = (element, handler) => {
                if (!element) return;
                let lastRunAt = 0;
                const run = (e) => {
                    const now = performance.now();
                    if (now - lastRunAt < 320) {
                        e.preventDefault();
                        e.stopPropagation();
                        return;
                    }
                    lastRunAt = now;
                    e.preventDefault();
                    e.stopPropagation();
                    handler();
                };
                // pointerup covers mobile; click covers desktop / keyboard activation.
                element.addEventListener('pointerup', (e) => {
                    if (e.button != null && e.button !== 0) return;
                    run(e);
                });
                element.addEventListener('click', run);
            };

            bindControl(modalClose, closeImageModal);
            bindControl(modalPrev, prevImage);
            bindControl(modalNext, nextImage);
            bindControl(modalZoomIn, () => zoomIn());
            bindControl(modalZoomOut, () => zoomOut());
            bindControl(modalZoomReset, () => resetZoom({ animate: true }));

            // Don't use click-to-dismiss: setPointerCapture retargets click onto the modal,
            // so image taps looked like backdrop taps and closed the viewer.

            modalImg.addEventListener('dblclick', (e) => {
                e.preventDefault();
                if (performance.now() < suppressClickUntil) return;
                handleDoubleTap(e.clientX, e.clientY);
            });

            modalImg.addEventListener('transitionend', (e) => {
                if (e.propertyName === 'transform') {
                    modalImg.classList.remove('is-animating');
                }
            });

            modal.addEventListener('wheel', (e) => {
                if (!modal.classList.contains('active')) return;
                e.preventDefault();

                modalImg.classList.remove('is-animating');

                let delta = e.deltaY;
                // Some trackpads report horizontal dominance; still zoom from the main delta.
                if (Math.abs(e.deltaX) > Math.abs(delta)) delta = e.deltaX;
                if (e.deltaMode === 1) delta *= 16; // lines → pixels
                if (e.deltaMode === 2) delta *= 32; // pages → pixels

                // ctrlKey marks trackpad pinch-to-zoom on Chromium / Firefox / Safari.
                const scale = e.ctrlKey ? TRACKPAD_PINCH_SCALE : WHEEL_ZOOM_SCALE;
                const factor = Math.exp(-delta * scale);
                setZoom(zoomLevel * factor, e.clientX, e.clientY, { animate: false });
            }, { passive: false });

            const onPointerDown = (e) => {
                if (!modal.classList.contains('active')) return;
                // Touch is handled by touch_* listeners (more reliable multi-touch on mobile).
                if (e.pointerType === 'touch') return;
                if (e.pointerType === 'mouse' && e.button !== 0) return;
                if (e.target.closest('.image-modal-btn, .image-modal-toolbar')) return;

                const onImage = Boolean(e.target.closest('.image-modal-img, .image-modal-content'));
                pointerDownOnImage = onImage;
                backdropDismissId = onImage ? null : e.pointerId;

                e.preventDefault();
                try { modal.setPointerCapture(e.pointerId); } catch (_) {}

                const point = { id: e.pointerId, x: e.clientX, y: e.clientY };
                pointers.set(e.pointerId, point);

                if (pointers.size >= 2) {
                    backdropDismissId = null;
                    beginPinch();
                    return;
                }

                if (zoomLevel > 1.001) {
                    backdropDismissId = null;
                    beginPan(point);
                }
            };

            const onPointerMove = (e) => {
                if (e.pointerType === 'touch') return;
                if (!pointers.has(e.pointerId)) return;

                const point = { id: e.pointerId, x: e.clientX, y: e.clientY };
                pointers.set(e.pointerId, point);

                if (pointers.size >= 2) {
                    backdropDismissId = null;
                    if (!gesture || gesture.type !== 'pinch') beginPinch();
                    updatePinch();
                    return;
                }

                if (gesture?.type === 'pan') {
                    backdropDismissId = null;
                    updatePan(point);
                }
            };

            const onPointerUp = (e) => {
                if (e.pointerType === 'touch') return;
                if (!pointers.has(e.pointerId)) return;

                const startedOnImage = pointerDownOnImage;
                const canDismissBackdrop =
                    backdropDismissId === e.pointerId &&
                    !startedOnImage &&
                    !gesture?.moved &&
                    gesture?.type !== 'pinch' &&
                    performance.now() >= suppressClickUntil;

                const result = endGesturePointer(e.pointerId);
                try { modal.releasePointerCapture(e.pointerId); } catch (_) {}

                backdropDismissId = null;
                pointerDownOnImage = false;

                if (result.pinched || result.moved) {
                    suppressClickUntil = performance.now() + 280;
                }

                if (canDismissBackdrop && !result.moved && !result.pinched) {
                    closeImageModal();
                }
            };

            const onTouchStart = (e) => {
                if (!modal.classList.contains('active')) return;
                if (isModalControl(e.target)) {
                    touchOnControls = true;
                    return;
                }

                touchOnControls = false;
                const onImage = Boolean(e.target.closest('.image-modal-img, .image-modal-content'));
                pointerDownOnImage = onImage;
                backdropDismissId = onImage ? null : 'touch';

                e.preventDefault();
                syncPointersFromTouches(e.touches);

                if (pointers.size >= 2) {
                    backdropDismissId = null;
                    beginPinch();
                    return;
                }

                if (pointers.size === 1 && zoomLevel > 1.001) {
                    backdropDismissId = null;
                    beginPan(Array.from(pointers.values())[0]);
                }
            };

            const onTouchMove = (e) => {
                if (!modal.classList.contains('active')) return;
                if (touchOnControls || isModalControl(e.target)) return;
                if (!pointers.size && !e.touches.length) return;

                e.preventDefault();
                syncPointersFromTouches(e.touches);

                if (pointers.size >= 2) {
                    backdropDismissId = null;
                    if (!gesture || gesture.type !== 'pinch') beginPinch();
                    updatePinch();
                    return;
                }

                if (pointers.size === 1 && gesture?.type === 'pan') {
                    backdropDismissId = null;
                    updatePan(Array.from(pointers.values())[0]);
                }
            };

            const onTouchEnd = (e) => {
                if (!modal.classList.contains('active')) return;

                // Never swallow taps on zoom / close / nav controls.
                if (touchOnControls || isModalControl(e.target)) {
                    touchOnControls = false;
                    return;
                }

                const startedOnImage = pointerDownOnImage;
                const hadPinch = gesture?.type === 'pinch';
                const hadPanMove = Boolean(gesture?.moved);
                const canDismissBackdrop =
                    backdropDismissId === 'touch' &&
                    !startedOnImage &&
                    !hadPanMove &&
                    !hadPinch &&
                    e.touches.length === 0 &&
                    performance.now() >= suppressClickUntil;

                const tapPoint = pointers.size === 1 ? Array.from(pointers.values())[0] : null;
                const wasSingleTapCandidate =
                    e.touches.length === 0 &&
                    Boolean(tapPoint) &&
                    !hadPinch &&
                    !hadPanMove &&
                    startedOnImage;

                e.preventDefault();
                syncPointersFromTouches(e.touches);

                if (pointers.size >= 2) {
                    beginPinch();
                    backdropDismissId = null;
                    pointerDownOnImage = false;
                    return;
                }

                if (pointers.size === 1 && zoomLevel > 1.001) {
                    beginPan(Array.from(pointers.values())[0]);
                    backdropDismissId = null;
                    pointerDownOnImage = false;
                    return;
                }

                gesture = null;
                setGesturing(false);
                zoomLevel = roundZoom(clampZoom(zoomLevel));
                if (zoomLevel <= ZOOM_MIN + 0.001) {
                    zoomLevel = 1;
                    panX = 0;
                    panY = 0;
                }
                applyImageTransform();
                updateZoomUi();

                backdropDismissId = null;
                pointerDownOnImage = false;

                if (hadPinch || hadPanMove) {
                    suppressClickUntil = performance.now() + 280;
                }

                if (canDismissBackdrop) {
                    closeImageModal();
                    return;
                }

                if (!wasSingleTapCandidate || !tapPoint) return;

                const now = performance.now();
                const dt = now - lastTapAt;
                const dist = Math.hypot(tapPoint.x - lastTapX, tapPoint.y - lastTapY);
                if (dt > 0 && dt < DOUBLE_TAP_MS && dist < DOUBLE_TAP_SLOP) {
                    handleDoubleTap(tapPoint.x, tapPoint.y);
                    lastTapAt = 0;
                    suppressClickUntil = now + 280;
                } else {
                    lastTapAt = now;
                    lastTapX = tapPoint.x;
                    lastTapY = tapPoint.y;
                }
            };

            modal.addEventListener('pointerdown', onPointerDown, { passive: false });
            modal.addEventListener('pointermove', onPointerMove, { passive: false });
            modal.addEventListener('pointerup', onPointerUp);
            modal.addEventListener('pointercancel', onPointerUp);

            // Touch events give all active fingers each frame — better pinch on phones.
            modal.addEventListener('touchstart', onTouchStart, { passive: false });
            modal.addEventListener('touchmove', onTouchMove, { passive: false });
            modal.addEventListener('touchend', onTouchEnd, { passive: false });
            modal.addEventListener('touchcancel', onTouchEnd, { passive: false });

            // Safari / macOS trackpad pinch (separate from wheel).
            modal.addEventListener('gesturestart', (e) => {
                if (!modal.classList.contains('active')) return;
                e.preventDefault();
                gestureStartZoom = zoomLevel;
                modalImg.classList.remove('is-animating');
            }, { passive: false });

            modal.addEventListener('gesturechange', (e) => {
                if (!modal.classList.contains('active')) return;
                e.preventDefault();
                // Amplify native scale so a small pinch jumps in quickly.
                const amplified = Math.pow(e.scale, 1.55);
                const center = getStageCenter();
                setZoom(
                    gestureStartZoom * amplified,
                    center.x,
                    center.y,
                    { animate: false }
                );
            }, { passive: false });

            modal.addEventListener('gestureend', (e) => {
                if (!modal.classList.contains('active')) return;
                e.preventDefault();
            }, { passive: false });

            document.addEventListener('keydown', (e) => {
                if (!modal.classList.contains('active')) return;

                if (e.key === 'Escape') {
                    closeImageModal();
                } else if (e.key === 'ArrowLeft') {
                    prevImage();
                } else if (e.key === 'ArrowRight') {
                    nextImage();
                } else if (e.key === '+' || e.key === '=') {
                    e.preventDefault();
                    zoomIn();
                } else if (e.key === '-' || e.key === '_') {
                    e.preventDefault();
                    zoomOut();
                } else if (e.key === '0') {
                    resetZoom({ animate: true });
                }
            });
        });

        document.addEventListener('DOMContentLoaded', () => {
            const project = <%~ projectJson %>;
            if (!project) return;

            document.querySelectorAll('.project-detail-image').forEach((image, index) => {
                image.addEventListener('click', () => openImageModal(index, project.images));
            });
        });
    </script>
</body>

</html>
