<!DOCTYPE html>
<html lang="en" data-theme="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Project Details - Darkguyaiman</title>
    <meta name="description" id="metaDescription" content="Project details by Mohamed Aiman - Web Developer Portfolio">
    <meta name="keywords" id="metaKeywords" content="Mohamed Aiman, web development, project">
    <meta name="author" content="Mohamed Aiman">
    <meta name="robots" content="index, follow">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" id="ogType">
    <meta property="og:url" id="ogUrl" content="">
    <meta property="og:title" id="ogTitle" content="Project Details - Darkguyaiman">
    <meta property="og:description" id="ogDescription" content="Project details by Mohamed Aiman">
    <meta property="og:image" id="ogImage" content="https://darkguyaiman.github.io/assets/Mohamed Aiman.webp">

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:url" id="twitterUrl" content="">
    <meta name="twitter:title" id="twitterTitle" content="Project Details - Darkguyaiman">
    <meta name="twitter:description" id="twitterDescription" content="Project details by Mohamed Aiman">
    <meta name="twitter:image" id="twitterImage"
        content="https://darkguyaiman.github.io/assets/Mohamed Aiman.webp">

    <!-- Canonical URL -->
    <link rel="canonical" id="canonicalUrl" href="">

    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <script>
        (function () {
            const savedTheme = localStorage.getItem('theme') || 'dark';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
    <style>html{background:#fdfbf7}html[data-theme="dark"]{background:#1a1a1c}</style>
    <link rel="preload" href="/vendor/fonts/inter/inter-latin-400-normal.woff2?v=<%= assetVersion %>" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/css/app.min.css?v=<%= assetVersion %>">
    <link rel="stylesheet" href="/css/detail.min.css?v=<%= assetVersion %>">
    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= assetVersion %>">
    <link rel="stylesheet" href="/vendor/devicon/devicon.min.css?v=<%= assetVersion %>">
    <link rel="stylesheet" href="/vendor/lenis/lenis.css?v=<%= assetVersion %>">
</head>

<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="nav-container">
            <div class="logo">
                <a href="/" class="logo-link">Darkguyaiman</a>
                <!-- Easter Egg Modal -->
                <div class="easter-egg" id="easterEgg">
                    <div class="easter-egg-content">
                        <div class="easter-egg-image-container">
                            <img src="/assets/2D Mohamed.webp" alt="2D Mohamed" class="easter-egg-image">
                        </div>
                        <div class="easter-egg-name">darkguyaiman</div>
                        <div class="easter-egg-message" id="easterEggMessage"></div>
                    </div>
                </div>
            </div>
            <ul class="nav-menu" id="navMenu">
                <li class="nav-close-container">
                    <button class="nav-close-btn" id="navCloseBtn" aria-label="Close menu">
                        <i class="fas fa-times"></i>
                    </button>
                </li>
                <li><a href="/#home" class="nav-link">home</a></li>
                <li><a href="/#projects" class="nav-link">projects</a></li>
                <li><a href="/#work" class="nav-link">work</a></li>
                <li><a href="/#education" class="nav-link">education</a></li>
                <li><a href="/#languages" class="nav-link">languages</a></li>
                <li><a href="/#contact" class="nav-link">contact</a></li>
                <li class="nav-image-container">
                    <div class="nav-image-wrapper">
                        <div class="nav-greeting-wrapper">
                            <span class="nav-greeting" id="navGreeting"></span>
                        </div>
                        <div class="nav-image-content">
                            <div class="nav-image-glow"></div>
                            <img src="/assets/2D Mohamed Leaning.webp" alt="2D Mohamed Leaning"
                                class="nav-leaning-image">
                            <div class="nav-name">darkguyaiman</div>
                        </div>
                    </div>
                </li>
            </ul>
            <div class="nav-controls">
                <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme">
                    <i class="fas fa-sun" id="themeIcon"></i>
                </button>
                <div class="hamburger" id="hamburger">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
        </div>
    </nav>

    <main>
        <!-- Project Detail Section -->
        <section class="project-detail">
            <div class="container">
                <a href="/projects" class="back-link">
                    <i class="fas fa-chevron-left"></i>
                    <span>back to projects</span>
                </a>

                <div class="project-detail-header">
                    <h1 class="project-detail-title" id="projectTitle"></h1>
                    <p class="project-detail-description" id="projectDescription"></p>
                </div>

                <div class="project-detail-images" id="projectImages"></div>

                <div class="project-detail-tech">
                    <h3 class="section-title" style="margin-bottom: 1rem;">technologies used</h3>
                    <div class="project-tech-icons" id="projectTech"></div>
                </div>

                <div class="project-detail-links" id="projectLinks"></div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p>&copy; <span class="footer-year">2025</span> Mohamed Aiman | <a href="/privacy"
                    class="footer-link">privacy?</a></p>
        </div>
    </footer>

    <!-- Image Modal -->
    <div class="image-modal" id="imageModal" role="dialog" aria-modal="true" aria-label="Image viewer" hidden>
        <button type="button" class="image-modal-btn image-modal-close" id="modalClose" aria-label="Close image viewer">
            <i class="fas fa-times" aria-hidden="true"></i>
        </button>
        <button type="button" class="image-modal-btn image-modal-nav image-modal-prev" id="modalPrev" aria-label="Previous image">
            <i class="fas fa-chevron-left" aria-hidden="true"></i>
        </button>
        <button type="button" class="image-modal-btn image-modal-nav image-modal-next" id="modalNext" aria-label="Next image">
            <i class="fas fa-chevron-right" aria-hidden="true"></i>
        </button>
        <div class="image-modal-stage" id="modalStage">
            <div class="image-modal-content" id="modalContent">
                <img class="image-modal-img" id="modalImage" src="" alt="">
            </div>
        </div>
        <div class="image-modal-toolbar">
            <div class="image-modal-zoom">
                <button type="button" class="image-modal-btn image-modal-zoom-btn" id="modalZoomOut" aria-label="Zoom out">
                    <i class="fas fa-minus" aria-hidden="true"></i>
                </button>
                <span class="image-modal-zoom-level" id="modalZoomLevel">100%</span>
                <button type="button" class="image-modal-btn image-modal-zoom-btn" id="modalZoomIn" aria-label="Zoom in">
                    <i class="fas fa-plus" aria-hidden="true"></i>
                </button>
                <button type="button" class="image-modal-btn image-modal-zoom-btn image-modal-reset" id="modalZoomReset" aria-label="Reset zoom">
                    <i class="fas fa-compress" aria-hidden="true"></i>
                </button>
            </div>
            <div class="image-modal-counter" id="modalCounter"></div>
        </div>
    </div>

    <script src="/vendor/lenis/lenis.min.js"></script>
    <script src="/js/app.min.js"></script>
    <script>

        function getTechIcon(tech) {

            const iconData = window.techIconMap ? window.techIconMap[tech] : null;
            if (!iconData) {

                return `<div class="tech-icon-item" data-tech="${tech.toLowerCase()}" title="${tech}">
                    <span class="tech-icon-name">${tech}</span>
                </div>`;
            }


            const techKey = tech.toLowerCase().replace(/\s+/g, '').replace('.', '');

            if (iconData.type === 'ejs') {
                return `<div class="tech-icon-item" data-tech="ejs" title="${tech}">
                    <span class="ejs-icon">EJS</span>
                    <span class="tech-icon-name">EJS</span>
                </div>`;
            }

            if (iconData.type === 'fa') {
                return `<div class="tech-icon-item" data-tech="${techKey}" title="${tech}">
                    <i class="${iconData.class}"></i>
                    <span class="tech-icon-name">${tech}</span>
                </div>`;
            }

            return `<div class="tech-icon-item" data-tech="${techKey}" title="${tech}">
                <i class="${iconData.class}"></i>
                <span class="tech-icon-name">${tech}</span>
            </div>`;
        }


        let currentImageIndex = 0;
        let projectImages = [];
        let zoomLevel = 1;
        let panX = 0;
        let panY = 0;
        let isPanning = false;
        let panStartX = 0;
        let panStartY = 0;
        let originPanX = 0;
        let originPanY = 0;
        const ZOOM_MIN = 1;
        const ZOOM_MAX = 4;
        const ZOOM_STEP = 0.25;

        function clampZoom(value) {
            return Math.min(ZOOM_MAX, Math.max(ZOOM_MIN, Math.round(value * 100) / 100));
        }

        function applyImageTransform() {
            const modalImg = document.getElementById('modalImage');
            const modalContent = document.getElementById('modalContent');
            const zoomLabel = document.getElementById('modalZoomLevel');
            const zoomOutBtn = document.getElementById('modalZoomOut');
            const zoomInBtn = document.getElementById('modalZoomIn');
            const zoomResetBtn = document.getElementById('modalZoomReset');

            const modal = document.getElementById('imageModal');
            modalImg.style.transform = `translate(${panX}px, ${panY}px) scale(${zoomLevel})`;
            modalContent.classList.toggle('is-zoomed', zoomLevel > 1);
            modal.classList.toggle('is-zoomed', zoomLevel > 1);
            zoomLabel.textContent = `${Math.round(zoomLevel * 100)}%`;
            zoomOutBtn.disabled = zoomLevel <= ZOOM_MIN;
            zoomInBtn.disabled = zoomLevel >= ZOOM_MAX;
            zoomResetBtn.disabled = zoomLevel === 1 && panX === 0 && panY === 0;
        }

        function resetZoom(hard = true) {
            zoomLevel = 1;
            if (hard) {
                panX = 0;
                panY = 0;
            }
            applyImageTransform();
        }

        function setZoom(nextZoom, anchorX, anchorY) {
            const modalStage = document.getElementById('modalStage');
            const prevZoom = zoomLevel;
            const clamped = clampZoom(nextZoom);
            if (clamped === prevZoom) {
                applyImageTransform();
                return;
            }

            if (clamped === 1) {
                panX = 0;
                panY = 0;
            } else if (typeof anchorX === 'number' && typeof anchorY === 'number') {
                const rect = modalStage.getBoundingClientRect();
                const centerX = rect.left + rect.width / 2;
                const centerY = rect.top + rect.height / 2;
                const offsetX = anchorX - centerX;
                const offsetY = anchorY - centerY;
                const ratio = clamped / prevZoom;
                panX = offsetX - (offsetX - panX) * ratio;
                panY = offsetY - (offsetY - panY) * ratio;
            }

            zoomLevel = clamped;
            applyImageTransform();
        }

        function zoomIn(anchorX, anchorY) {
            setZoom(zoomLevel + ZOOM_STEP, anchorX, anchorY);
        }

        function zoomOut(anchorX, anchorY) {
            setZoom(zoomLevel - ZOOM_STEP, anchorX, anchorY);
        }

        function openImageModal(index, images) {
            projectImages = images;
            currentImageIndex = index;
            const modal = document.getElementById('imageModal');
            const modalImg = document.getElementById('modalImage');

            modalImg.src = `/${images[index]}`;
            modalImg.alt = `Project image ${index + 1}`;
            modal.hidden = false;
            modal.classList.add('active');
            document.body.classList.add('image-modal-open');
            resetZoom();
            updateModalCounter();
            updateNavVisibility();
        }

        function closeImageModal() {
            const modal = document.getElementById('imageModal');
            modal.classList.remove('active');
            modal.hidden = true;
            document.body.classList.remove('image-modal-open');
            resetZoom();
        }

        function nextImage() {
            if (projectImages.length <= 1) return;
            currentImageIndex = (currentImageIndex + 1) % projectImages.length;
            const modalImg = document.getElementById('modalImage');
            modalImg.src = `/${projectImages[currentImageIndex]}`;
            modalImg.alt = `Project image ${currentImageIndex + 1}`;
            resetZoom();
            updateModalCounter();
        }

        function prevImage() {
            if (projectImages.length <= 1) return;
            currentImageIndex = (currentImageIndex - 1 + projectImages.length) % projectImages.length;
            const modalImg = document.getElementById('modalImage');
            modalImg.src = `/${projectImages[currentImageIndex]}`;
            modalImg.alt = `Project image ${currentImageIndex + 1}`;
            resetZoom();
            updateModalCounter();
        }

        function updateModalCounter() {
            const modalCounter = document.getElementById('modalCounter');
            modalCounter.textContent = `${currentImageIndex + 1} / ${projectImages.length}`;
        }

        function updateNavVisibility() {
            const modalPrev = document.getElementById('modalPrev');
            const modalNext = document.getElementById('modalNext');
            const showNav = projectImages.length > 1;
            modalPrev.hidden = !showNav;
            modalNext.hidden = !showNav;
        }

        document.addEventListener('DOMContentLoaded', () => {
            const modal = document.getElementById('imageModal');
            const modalImg = document.getElementById('modalImage');
            const modalStage = document.getElementById('modalStage');
            const modalClose = document.getElementById('modalClose');
            const modalPrev = document.getElementById('modalPrev');
            const modalNext = document.getElementById('modalNext');
            const modalZoomIn = document.getElementById('modalZoomIn');
            const modalZoomOut = document.getElementById('modalZoomOut');
            const modalZoomReset = document.getElementById('modalZoomReset');

            modalClose.addEventListener('click', closeImageModal);
            modalPrev.addEventListener('click', prevImage);
            modalNext.addEventListener('click', nextImage);
            modalZoomIn.addEventListener('click', () => zoomIn());
            modalZoomOut.addEventListener('click', () => zoomOut());
            modalZoomReset.addEventListener('click', () => resetZoom());

            modal.addEventListener('click', (e) => {
                if (e.target === modal) {
                    closeImageModal();
                    return;
                }
                if (e.target === modalStage && zoomLevel === 1) {
                    closeImageModal();
                }
            });

            modalImg.addEventListener('dblclick', (e) => {
                e.preventDefault();
                if (zoomLevel > 1) {
                    resetZoom();
                } else {
                    setZoom(2, e.clientX, e.clientY);
                }
            });

            modalStage.addEventListener('wheel', (e) => {
                if (!modal.classList.contains('active')) return;
                e.preventDefault();
                if (e.deltaY < 0) {
                    zoomIn(e.clientX, e.clientY);
                } else {
                    zoomOut(e.clientX, e.clientY);
                }
            }, { passive: false });

            modalImg.addEventListener('pointerdown', (e) => {
                if (zoomLevel <= 1) return;
                isPanning = true;
                panStartX = e.clientX;
                panStartY = e.clientY;
                originPanX = panX;
                originPanY = panY;
                modalImg.setPointerCapture(e.pointerId);
                modalImg.classList.add('is-panning');
            });

            modalImg.addEventListener('pointermove', (e) => {
                if (!isPanning) return;
                panX = originPanX + (e.clientX - panStartX);
                panY = originPanY + (e.clientY - panStartY);
                applyImageTransform();
            });

            const endPan = (e) => {
                if (!isPanning) return;
                isPanning = false;
                modalImg.classList.remove('is-panning');
                if (e && e.pointerId != null) {
                    try { modalImg.releasePointerCapture(e.pointerId); } catch (_) {}
                }
            };

            modalImg.addEventListener('pointerup', endPan);
            modalImg.addEventListener('pointercancel', endPan);

            document.addEventListener('keydown', (e) => {
                if (!modal.classList.contains('active')) return;

                if (e.key === 'Escape') {
                    closeImageModal();
                } else if (e.key === 'ArrowLeft') {
                    prevImage();
                } else if (e.key === 'ArrowRight') {
                    nextImage();
                } else if (e.key === '+' || e.key === '=') {
                    e.preventDefault();
                    zoomIn();
                } else if (e.key === '-' || e.key === '_') {
                    e.preventDefault();
                    zoomOut();
                } else if (e.key === '0') {
                    resetZoom();
                }
            });
        });

        function getProjectSlug() {
            const slug = window.location.pathname.split('/').filter(Boolean).pop();
            return slug === 'projects' ? null : slug;
        }


        async function loadProjectDetail() {
            try {
                const projectSlug = getProjectSlug();

                if (!projectSlug) {
                    document.body.innerHTML = '<div class="container" style="padding-top: 120px;"><h1>Project not specified</h1><a href="/projects">Back to Projects</a></div>';
                    return;
                }

                const response = await fetch(`/api/projects/${encodeURIComponent(projectSlug)}`);
                const project = response.ok ? await response.json() : null;

                if (!project) {
                    document.body.innerHTML = '<div class="container" style="padding-top: 120px;"><h1>Project not found</h1><a href="/projects">Back to Projects</a></div>';
                    return;
                }


                const baseUrl = 'https://darkguyaiman.github.io';
                const currentUrl = `${baseUrl}/projects/${project.slug}`;
                const projectImage = project.images && project.images.length > 0
                    ? `${baseUrl}/${project.images[0]}`
                    : `${baseUrl}/assets/Mohamed Aiman.webp`;
                const techKeywords = project.techUsed.join(', ');


                const truncateDescription = (text, maxLength = 155) => {
                    if (text.length <= maxLength) return text;
                    return text.substring(0, maxLength).trim() + '...';
                };

                const seoDescription = truncateDescription(project.description);
                const fullDescription = `${seoDescription} Built with: ${techKeywords}`;


                document.title = `${project.projectName} - Mohamed Aiman Portfolio`;


                document.getElementById('metaDescription').setAttribute('content', truncateDescription(fullDescription, 160));


                document.getElementById('metaKeywords').setAttribute('content', `${project.projectName}, ${techKeywords}, Mohamed Aiman, web development, project`);


                document.getElementById('ogUrl').setAttribute('content', currentUrl);
                document.getElementById('ogTitle').setAttribute('content', `${project.projectName} - Mohamed Aiman Portfolio`);
                document.getElementById('ogDescription').setAttribute('content', seoDescription);
                document.getElementById('ogImage').setAttribute('content', projectImage);


                document.getElementById('twitterUrl').setAttribute('content', currentUrl);
                document.getElementById('twitterTitle').setAttribute('content', `${project.projectName} - Mohamed Aiman Portfolio`);
                document.getElementById('twitterDescription').setAttribute('content', seoDescription);
                document.getElementById('twitterImage').setAttribute('content', projectImage);


                document.getElementById('canonicalUrl').setAttribute('href', currentUrl);


                const projectTitle = document.getElementById('projectTitle');
                projectTitle.textContent = project.projectName;
                if (typeof window.animateTextByCharacter === 'function') {
                    window.animateTextByCharacter(projectTitle);
                }
                document.getElementById('projectDescription').textContent = project.description;


                const techContainer = document.getElementById('projectTech');
                techContainer.innerHTML = project.techUsed.map(tech => getTechIcon(tech)).join('');


                const imagesContainer = document.getElementById('projectImages');
                if (project.images && project.images.length > 0) {
                    imagesContainer.innerHTML = project.images.map((img, index) =>
                        `<img src="/${img}" alt="${project.projectName}" class="project-detail-image" data-image-index="${index}">`
                    ).join('');


                    const images = imagesContainer.querySelectorAll('.project-detail-image');
                    images.forEach((img, index) => {
                        img.addEventListener('click', () => {
                            openImageModal(index, project.images);
                        });
                    });
                } else {
                    imagesContainer.style.display = 'none';
                }


                const linksContainer = document.getElementById('projectLinks');
                const links = [];
                if (project.deployedLink) {
                    links.push(`<a href="${project.deployedLink}" target="_blank" rel="noopener noreferrer" class="project-link" aria-label="View ${project.projectName} website"><i class="fas fa-external-link-alt" aria-hidden="true"></i><span>Website</span></a>`);
                }
                if (project.githubLink) {
                    links.push(`<a href="${project.githubLink}" target="_blank" rel="noopener noreferrer" class="project-link" aria-label="View ${project.projectName} source code"><i class="fab fa-github" aria-hidden="true"></i><span>Source</span></a>`);
                }
                linksContainer.innerHTML = links.join('');
                linksContainer.hidden = links.length === 0;
            } catch (error) {
                console.error('Error loading project details:', error);
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            loadProjectDetail();
        });
    </script>
</body>

</html>
