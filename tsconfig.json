{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "NodeNext",
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/portfolio.tsbuildinfo"
  },
  "include": ["server.ts", "config/**/*.ts", "controllers/**/*.ts", "models/**/*.ts", "routes/**/*.ts", "utils/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
