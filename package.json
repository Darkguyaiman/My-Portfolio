{
  "name": "my-portfolio",
  "version": "1.0.0",
  "description": "Portfolio website built with TypeScript, Express, and Eta",
  "main": "dist/server.js",
  "scripts": {
    "build": "npm run build:server && npm run build:assets",
    "build:server": "tsc",
    "build:assets": "npm run build:vendor && npm run build:css && npm run build:js",
    "build:vendor": "node scripts/copy-vendor-assets.js",
    "build:css": "node scripts/build-css.js",
    "build:js": "terser ./src/js/app.js --compress --mangle --output ./public/js/app.min.js",
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "@fontsource/playfair-display": "^5.2.8",
    "@types/multer": "^2.2.0",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "eta": "^4.6.0",
    "express": "^4.18.2",
    "multer": "^2.2.0",
    "mysql2": "^3.22.5"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/press-start-2p": "^5.2.7",
    "@fortawesome/fontawesome-free": "^7.3.0",
    "@tailwindcss/cli": "^4.3.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "devicon": "^2.17.0",
    "lenis": "^1.3.25",
    "tailwindcss": "^4.3.1",
    "terser": "^5.48.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.3.2"
  },
  "license": "ISC",
  "type": "module"
}
